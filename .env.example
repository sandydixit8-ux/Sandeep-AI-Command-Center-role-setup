# Copy to .env and fill in. At least one provider key is required (or use --mock).

# anthropic | openai | mock
AGENT_LLM_PROVIDER=anthropic

# Anthropic (use your existing ResumeIQ key or a new one)
AGENT_ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI-compatible (OpenAI, Groq, LM Studio, Ollama, etc.)
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_OPENAI_MODEL=gpt-4o-mini

# Optional web search. Leave empty to use DuckDuckGo HTML (may be rate-limited).
# Set to a Brave/SerpAPI key if you have one: AGENT_SEARCH_BRAVE_API_KEY=...

# Gmail integration (exec assistant inbox triage + reply drafts)
# Create an app password at https://myaccount.google.com/apppasswords
AGENT_GMAIL_USER=
AGENT_GMAIL_APP_PASSWORD=

# Google Sheets ledger sync (optional)
# 1. Create a service account in Google Cloud Console, share your sheet with its email.
# 2. AGENT_GOOGLE_SERVICE_ACCOUNT_FILE = absolute path to the downloaded JSON
# 3. AGENT_SHEET_ID = id from the sheet URL (docs.google.com/spreadsheets/d/<ID>/edit)
AGENT_GOOGLE_SERVICE_ACCOUNT_FILE=
AGENT_SHEET_ID=
AGENT_SHEET_RANGE=A1:E1000

# Tuning (optional)
AGENT_TIMEOUT=90
AGENT_MAX_TOOL_STEPS=10

# Upstox broker execution layer (SEBI-algo compliant). FAIL-CLOSED: broker is
# OFF unless UPSTOX_MODE is set. Use 'mock' to simulate (no network), 'sandbox'
# for Upstox sandbox credentials, or 'live' for real-money orders.
# Real-money ('live') orders ALSO require LIVE_TRADING_ENABLED=true (safety gate).
UPSTOX_MODE=off
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://api-v2.upstox.com/redirect
UPSTOX_AUTH_CODE=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REFRESH_TOKEN=
# Path to broker BOD instruments CSV (instrument_key, trading_symbol, ...)
UPSTOX_INSTRUMENTS_FILE=
# Exchange-registered algo strategy ID (SEBI algo-ID tagging; REQUIRED for live)
UPSTOX_ALGO_ID=
# Rate cap for automated orders (SEBI <10 orders/sec registration threshold)
UPSTOX_MAX_ORDERS_PER_SEC=5

# Daily-loss circuit breaker. When tripped, no new positions are opened for the
# rest of the day (risk-reducing closes still allowed). Reference capital used
# to compute the absolute INR limit; the provider (paper portfolio / broker) is
# auto-registered. DAILY_LOSS_LIMIT_PCT applies to the start-of-day equity,
# DAILY_LOSS_LIMIT_INR overrides it with a fixed absolute amount.
DAILY_LOSS_CAPITAL=1000000
DAILY_LOSS_LIMIT_PCT=2.0
DAILY_LOSS_LIMIT_INR=

# Market data feed preference: 'upstox' (default; broker feed when configured,
# else Moneycontrol -> mock fallback), 'moneycontrol', or 'mock' (forced demo).
MARKET_DATA_SOURCE=upstox

# Mode A human-approval flow. When ON, the agent only drafts orders; a human
# must approve them (web UI/API) before anything executes. OFF = direct (Mode B).
ORDER_APPROVAL_MODE=off

# Automatic trading loop (web UI Start/Stop buttons + /api/v1/trading/*).
# While RUNNING the loop periodically runs the risk agent through the same gated
# tool path (kill switch + compliance + daily-loss breaker still apply per cycle).
AUTO_TRADE_INTERVAL=60
AUTO_TRADE_AGENT=risk
AUTO_TRADE_TASK=
